  "bin": { "google-kroegen": "./cli.mjs" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "start": "node cli.mjs"
  },
  "optionalDependencies": {
    "jpeg-js": "0.4.4",
    "playwright": "1.48.2",
    "tesseract.js": "6.0.1"
  },
  "overrides": {
    "wasm-feature-detect": "1.8.0"
  }
}
